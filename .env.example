# Vercel Blob read/write token (from a *public-access* Blob store attached to your Vercel project)
BLOB_READ_WRITE_TOKEN=

# Postgres connection string — Prisma manages its own migrations/schema
DATABASE_URL=postgres://user:password@localhost:5432/data_room_v2

# Random secret Better Auth uses to sign sessions — generate with `openssl rand -base64 32`
BETTER_AUTH_SECRET=

# The backend's own public URL — Better Auth uses this for OAuth callback URLs. Leave unset in
# production on Render: it falls back to Render's auto-injected RENDER_EXTERNAL_URL.
BETTER_AUTH_URL=http://localhost:3001

# Origin of the deployed/dev frontend, used for CORS + Better Auth trustedOrigins
FRONTEND_ORIGIN=http://localhost:5173

# Port the NestJS server listens on locally. In production, the host's own PORT env var
# (e.g. Render's) takes precedence — see server/src/main.ts — so don't set this on Render.
NEST_PORT=3001

# Google OAuth client (Google Cloud Console) — leave both empty to disable Google sign-in locally
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Backend origin for the frontend to call — leave empty locally (Vite proxies /api to
# NEST_PORT, same-origin). Set to the deployed backend's origin (no trailing /api) in prod.
VITE_API_URL=
