{
  "name": "data-room",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "dev": "vercel dev",
    "dev:vite": "vite",
    "dev:api": "tsx watch scripts/dev-api.ts",
    "dev:fast": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:vite\"",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "build:nest": "tsc -p server/tsconfig.nest.json",
    "start:nest": "node server/dist/server/src/main.js",
    "dev:nest": "npm run build:nest && concurrently -n tsc,run -c blue,green \"tsc -w -p server/tsconfig.nest.json\" \"node --watch server/dist/server/src/main.js\"",
    "typecheck:nest": "tsc -p server/tsconfig.nest.json --noEmit",
    "prisma:generate": "prisma generate --schema server/prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema server/prisma/schema.prisma",
    "prisma:studio": "prisma studio --schema server/prisma/schema.prisma"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/inter": "^5.2.8",
    "@hookform/resolvers": "^5.4.0",
    "@nestjs/common": "^11.2.1",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "@nestjs/throttler": "^6.5.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@tailwindcss/vite": "^4.3.2",
    "@tanstack/react-query": "^5.101.2",
    "@thallesp/nestjs-better-auth": "^2.7.0",
    "@vercel/blob": "^0.27.1",
    "better-auth": "^1.6.29",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.39.3",
    "express": "^4.21.2",
    "helmet": "^8.3.0",
    "lucide-react": "^1.23.0",
    "next-themes": "^0.4.6",
    "pg": "^8.13.1",
    "radix-ui": "^1.6.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.80.0",
    "react-pdf": "^9.2.1",
    "react-router-dom": "^7.2.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "shadcn": "^4.13.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.2",
    "tw-animate-css": "^1.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@nestjs/testing": "^11.2.1",
    "@types/express": "^4.17.21",
    "@types/node": "^24.13.2",
    "@types/pg": "^8.11.11",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^6.0.2",
    "@vercel/node": "^3.2.29",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "dotenv": "^17.4.2",
    "drizzle-kit": "^0.30.4",
    "oxlint": "^1.71.0",
    "prisma": "^7.9.1",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^3.0.5"
  }
}
